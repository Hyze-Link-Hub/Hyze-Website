# Stripe secret key. Use sk_test_... locally and sk_live_... in production.
# A restricted key (rk_test_... or rk_live_...) is also accepted.
STRIPE_SECRET_KEY=sk_test_...

# Stripe publishable key. Use pk_test_... locally and pk_live_... in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# One-time (lifetime) or recurring Price ID for Pro (price_...).
STRIPE_PRO_PRICE_ID=price_...

# Signing secret for POST /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
LASTFM_API_KEY=
IP_SALT=
